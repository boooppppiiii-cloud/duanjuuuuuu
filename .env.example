# 数据库与媒体目录；Compose 默认值通常无需修改
DATABASE_URL=sqlite:////app/backend/data/app.db
MEDIA_ROOT=/app/media
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
FRONTEND_PORT=5174
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=
PUBLIC_API_ORIGIN=http://127.0.0.1:8000
PUBLIC_UI_ORIGIN=http://127.0.0.1:5174
CREDENTIAL_SECRET=
META_GRAPH_VERSION=v24.0
PUBLIC_MEDIA_BASE_URL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# 本地媒体工具
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 文本生成：Gemini 为主、通义千问为备；至少配置一个
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Gemini 图像生成
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Server酱通知，可留空
SERVERCHAN_KEY=

# 平台 token 示例。数据库仅保存此环境变量名，不保存 token 本身
FB_PAGE_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# 评论本地离线翻译；首次启动下载一次语言包，之后不调用外部翻译接口
OFFLINE_TRANSLATION_ENABLED=true
OFFLINE_TRANSLATION_LANGUAGES=auto
OFFLINE_TRANSLATION_TARGET=zh
OFFLINE_TRANSLATION_AUTO_INSTALL=true
