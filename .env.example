# 数据库与媒体目录；Compose 默认值通常无需修改
DATABASE_URL=sqlite:////app/backend/data/app.db
MEDIA_ROOT=/app/media
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# 本机仅通过这个回环端口访问前端；生产环境由 Caddy 接管公网 80/443
FRONTEND_BIND_PORT=5174
# 生产环境运行 `docker compose --profile production ...` 时使用
APP_DOMAIN=app.duanju.chat
YOUTUBE_API_KEY=
RADAR_YOUTUBE_DAILY_SEARCH_LIMIT=60
RADAR_YOUTUBE_DAILY_QUOTA_BUDGET=5000
RADAR_YOUTUBE_QUERIES_PER_DRAMA=3
RADAR_DAILY_SCAN_HOUR=4
YOUTUBE_CHANNEL_IDS=
PUBLIC_API_ORIGIN=http://127.0.0.1:8000
PUBLIC_UI_ORIGIN=http://127.0.0.1:5174
CREDENTIAL_SECRET=
# 应用登录。生产环境必须在首次启动前设置开发者初始密码；不要提交真实值。
DEVELOPER_EMAIL=boooppppiiii@gmail.com
DEVELOPER_INITIAL_PASSWORD=
AUTH_SESSION_DAYS=30
# 可选：配置后才能增加邮箱所有权验证邮件；未配置时仍可用邮箱+密码注册登录。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# 云剧库默认使用同盘硬链接，不重复占用同一成品的磁盘块。
CLOUD_STORAGE_BACKEND=local
CLOUD_STORAGE_ROOT=/app/media/cloud-library
META_GRAPH_VERSION=v24.0
PUBLIC_MEDIA_BASE_URL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# 本地媒体工具
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 文本生成：Gemini 为主、通义千问为备；至少配置一个
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Gemini 图像生成
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Server酱通知，可留空
SERVERCHAN_KEY=

# 平台 token 示例。数据库仅保存此环境变量名，不保存 token 本身
FB_PAGE_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# 评论本地离线翻译；首次启动下载一次语言包，之后不调用外部翻译接口
OFFLINE_TRANSLATION_ENABLED=true
OFFLINE_TRANSLATION_LANGUAGES=auto
OFFLINE_TRANSLATION_TARGET=zh
OFFLINE_TRANSLATION_AUTO_INSTALL=true
